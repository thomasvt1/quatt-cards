{
  "name": "quatt-cards",
  "version": "0.6.1",
  "type": "module",
  "description": "Compact Home Assistant cards for Quatt heat pumps, heat storage and Chill, with native Chill controls",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
