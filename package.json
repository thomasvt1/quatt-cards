  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-istanbul": "^5.0.3",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-lib-source-maps": "^5.0.6",
    "istanbul-reports": "^3.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasvt1/quatt-cards.git"
  },
  "homepage": "https://github.com/thomasvt1/quatt-cards#readme",
